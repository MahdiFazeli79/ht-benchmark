# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# secrets — never commit (Tier-3 hard stop; see project git-authority policy)
.env
.env.*
*.key
*.pem
**/secrets*
**/credentials*
*_credentials.json
service-account*.json

# one-shot session handoff (ephemeral, never commit)
handoff.md

# pytest / tooling
.pytest_cache/

# session-local context (never part of the public benchmark)
.context/

# paid-run logs (throwaway; a metered run is invoked deliberately each session,
# never re-run from a committed script — so no runner is committed either)
*_run.log

# Pyverilog parser artifacts (written to cwd at parse time)
parser.out
parsetab.py

# dataset build caches (regenerable; never the source of truth)
data/samples/*/graphs/index_map.*.json
